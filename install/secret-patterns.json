{
  "normalization": ["raw", "percent-decode-once"],
  "patterns": [
    {"id": "private-key", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"},
    {"id": "service-token", "regex": "\\b(?:sk_live|sk_test|xox[baprs])[-_][A-Za-z0-9_-]{8,}\\b"},
    {"id": "github-token", "regex": "\\b(?:ghp|gho|ghu|ghs|ghr|github_pat)[_-][A-Za-z0-9_]{8,}\\b"},
    {"id": "named-token", "regex": "\\b(?:token|cookie|oauth[_ -]?code|api[_ -]?key)\\s*[:=]\\s*[\\\"']?(?!\\[REDACTED\\]|<|\\$\\{|[^\\s\\\"'<>$\\[\\]{};]*(?:\\.{3}|…))[^\\s\\\"'<>$\\[\\]{};]{8,}", "flags": "i"},
    {"id": "authorization", "regex": "\\bauthorization\\s*:\\s*(?:bearer|basic)\\s+[^\\s<>$\\[\\]{}]{8,}", "flags": "i"},
    {"id": "aws-access-key", "regex": "\\bAKIA[0-9A-Z]{16}\\b"},
    {"id": "npm-token", "regex": "\\bnpm_[A-Za-z0-9]{20,}\\b"},
    {"id": "google-api-key", "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b"},
    {"id": "gitlab-token", "regex": "\\bglpat-[0-9A-Za-z_-]{20,}\\b"},
    {"id": "pypi-token", "regex": "\\bpypi-[0-9A-Za-z_-]{20,}\\b"},
    {"id": "jwt", "regex": "\\beyJ[A-Za-z0-9_-]{12,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b"},
    {"id": "named-password", "regex": "\\b(?:password|passwd|secret|client_secret|private_key)\\s*[:=]\\s*[\\\"']?(?!\\[REDACTED\\]|<|\\$\\{|[^\\s\\\"'<>$\\[\\]{};]*(?:\\.{3}|…))[^\\s\\\"'<>$\\[\\]{};]{6,}", "flags": "i"},
    {"id": "account-key", "regex": "\\bAccountKey\\s*=\\s*[\\\"']?(?!\\[REDACTED\\]|<|\\$\\{|[^;\\s\\\"']*(?:\\.{3}|…))[^;\\s\\\"']{16,}", "flags": "i"},
    {"id": "url-credentials", "regex": "[a-z][a-z0-9+.-]*://[^\\s/:]+:[^\\s/@]+@[^\\s]+", "flags": "i"},
    {"id": "environment-assignment", "regex": "\\b[A-Za-z_][A-Za-z0-9_]*(?:TOKEN|SECRET|KEY|PASSWORD|PASSWD|CREDENTIAL|COOKIE|AUTH)[A-Za-z0-9_]*\\s*=\\s*[\\\"']?(?!\\[REDACTED\\]|<|\\$\\{|[^\\s\\\"'<>$\\[\\]{};]*(?:\\.{3}|…))[^\\s\\\"'<>$\\[\\]{};]{8,}", "flags": "i"}
  ]
}
