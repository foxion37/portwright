{
  "patterns": [
    {
      "id": "email",
      "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
      "scope": "content",
      "public": true
    },
    {
      "id": "private-ipv4",
      "regex": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|169\\.254\\.\\d{1,3}\\.\\d{1,3})\\b",
      "scope": "content",
      "public": true
    },
    {
      "id": "private-host",
      "regex": "\\b(?:localhost|[A-Za-z0-9-]+\\.(?:local|internal|lan|home))\\b",
      "flags": "i",
      "scope": "content",
      "public": true
    },
    {
      "id": "private-ipv6",
      "regex": "(?:\\bfd[0-9a-f]{2}:|\\bfe80:|(?<![0-9a-f:])::1(?![0-9a-f:]))",
      "flags": "i",
      "scope": "content",
      "public": true
    },
    {
      "id": "url-credentials",
      "regex": "[a-z][a-z0-9+.-]*://[^\\s/:]+:[^\\s/@]+@",
      "flags": "i",
      "scope": "content",
      "public": true
    },
    {
      "id": "absolute-home",
      "regex": "(?<![A-Za-z0-9_.-])/(?:Users|home)/[a-z0-9_-]+/",
      "flags": "i",
      "replacement": "~/",
      "public": true
    },
    {
      "id": "private-network",
      "regex": "\\b100\\.\\d+\\.\\d+\\.\\d+\\b",
      "public": true
    },
    {
      "id": "cloudflare-account",
      "regex": "\\baccount_id\\s*[:=]\\s*[\\\"']?[0-9a-f]{32}\\b",
      "flags": "i",
      "public": true
    }
  ],
  "substitutions": [],
  "exceptions": [
    {
      "value": "foxion37/portwright",
      "reason": "Public distribution repository reference, not a private account path"
    },
    {
      "value": "Copyright (c) 2026 foxion37",
      "reason": "Public upstream author attribution"
    },
    {
      "value": "opsvc",
      "reason": "Publicly documented tool command, not a user identifier"
    }
  ],
  "name_hints": [],
  "account_ids": [
    "account_id: 32 lowercase or uppercase hex digits (value not stored)"
  ],
  "bucket_names": [],
  "worker_names": [],
  "repositories": [
    "foxion37/portwright"
  ]
}
